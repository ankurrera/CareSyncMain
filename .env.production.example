# CareSync Production Environment Configuration
# Copy this file to .env.production or pass variables via --dart-define-from-file=.env.production.

APP_ENV=production

# Production Cloud endpoints
SUPABASE_URL=https://prod-project.supabase.co
SUPABASE_ANON_KEY=your_production_supabase_anon_key_here

# Deployed production biometric APIs
BIOMETRIC_API_URL=https://prod-biometrics.a.run.app
FALLBACK_BIOMETRIC_API_URL=https://prod-biometrics-fallback.hf.space
HF_TOKEN=production_huggingface_token
