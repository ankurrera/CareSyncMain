# CareSync Staging Environment Configuration
# Copy this file to .env.staging or .env for staging tests.

APP_ENV=staging

# Staging Cloud endpoints
SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_ANON_KEY=your_staging_supabase_anon_key_here

# Deployed staging biometric APIs
BIOMETRIC_API_URL=https://staging-biometrics.a.run.app
FALLBACK_BIOMETRIC_API_URL=https://staging-biometrics-fallback.hf.space
HF_TOKEN=staging_huggingface_token
