# Android Signing Configuration Example
# Copy this file to 'android/key.properties' and fill in your actual credentials.
# The 'android/key.properties' file is automatically git-ignored to prevent exposing secrets.

storePassword=your_keystore_password_here
keyPassword=your_key_password_here
keyAlias=your_key_alias_here
storeFile=../app/release.keystore
